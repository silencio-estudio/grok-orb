menu "Grok pet interface"
    choice PET_LANG
        prompt "Interface language"
        default PET_LANG_ES
        help
            Language of the on-screen texts. Spanish needs only the Latin-1
            Montserrat font; Chinese also links the Unifont CJK font
            (about 820 KB more in flash).

        config PET_LANG_ES
            bool "Spanish"
        config PET_LANG_ZH
            bool "Chinese (adds the CJK font)"
    endchoice

    choice PET_THEME
        prompt "Theme"
        default PET_THEME_SMOOTH
        help
            Smooth: the round pink orb with anti-aliased Montserrat text.
            8-bit: four colours from the same palette, Unifont pixel text,
            square widgets and an orb drawn in 8 px blocks at 8 frames/s.
            Both use the same spring-based motion.

        config PET_THEME_SMOOTH
            bool "Smooth"
        config PET_THEME_PIXEL
            bool "8-bit"
    endchoice

    config PET_DISPLAY_NAME
        string "Name shown on screen"
        default "Grok Orb"
        help
            Shown in grey above the title of Settings and of the connection
            page, followed by the battery level when there is a battery.
            The main orb screen does not show it.
endmenu
